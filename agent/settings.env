# Non-secret settings for the voice agent (safe to keep in the project).
# Secret keys are NOT here - they live in %LOCALAPPDATA%\ai-interview-coach\agent.env
# The avatar page (Choose avatar) updates the avatar and voice lines below.
VOICE_PROVIDER=gemini
# 2026-10-12: Google's stable voice model (free tier). The older 2.5 preview model
# kept closing sessions with "1007 CONTENT_TYPE_AUDIO" (a known Google bug).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voice must match the avatar. Female: Kore, Aoede, Leda. Male: Charon, Puck, Orus.
GEMINI_VOICE=Kore
# Silence (ms) before Gemini decides you finished speaking. Gemini default ~800.
# Lower = faster replies, but too low cuts you off during short pauses (Google: 500-800).
TURN_SILENCE_MS=500
# Spoken language (Gemini ignores language codes; this goes into the instructions).
COACH_LANGUAGE=English
# Interviewer: 3d = free 3D avatar in the browser (no time limit),
# video = LiveAvatar video avatar (uses LiveAvatar credits).
AVATAR_MODE=3d
# Video avatar. Wayne = free sandbox (about 1 minute per session, no credits).
# Any other avatar uses LiveAvatar credits (free plan: 10 per month, 1 per minute).
LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0
LIVEAVATAR_AVATAR_NAME='June HR'
LIVEAVATAR_VIDEO_QUALITY=medium
